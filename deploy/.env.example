# 候诊闻语 环境配置模板（复制为 .env 后按环境修改；密钥不入库）
# 所有配置均可被同名环境变量覆盖（12-Factor）

# ---- 运行环境 ----
APP_ENV=dev                      # dev / test / prod
HOST=127.0.0.1                   # 监听地址（生产置于 nginx 之后）
PORT=8000
LOG_LEVEL=INFO                   # DEBUG/INFO/WARNING/ERROR

# ---- 数据库 ----
DATABASE_URL=sqlite:///./app.db  # 生产建议绝对路径；可切 postgresql://…（需另装驱动）
RETENTION_DAYS=90                # 摘要记录保留期（天），到期清理线程删除并留痕
CLEANUP_AT="03:00"               # 每日清理执行时刻（服务器本地时间 HH:MM）

# ---- AI 供应商（Provider 抽象，见决策日志 D-05）----
AI_PROVIDER=mock                 # mock=无Key全功能开发测试演示；mimo=真实MiMo平台
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_API_KEY=                      # mimo 时必填（sk-xxxxx）
AI_CHAT_MODEL=mimo-v2.5
AI_TTS_MODEL=mimo-v2.5-tts
AI_TTS_VOICE=冰糖                # 内置音色：mimo_default/冰糖/茉莉/苏打/白桦…（默认 冰糖 中文女声，适老化）
AI_TIMEOUT_SECONDS=25            # 上游调用超时（<30s 总预算，留网络余量）
AI_MAX_ROUNDS=30                 # 最大对话轮次上限（PRD F3-R6，2026-08-24 用户拍板调至30）

# ---- 安全防刷（2026-08-24 加固）----
TRUST_PROXY=false              # 生产置于Nginx后置 true（启用X-Real-IP，防伪造头绕限流）
MIN_AUDIO_RMS=0.004            # 有效语音能量下限（静音/噪声刷量拒绝）
MIN_AUDIO_SECONDS=0.5          # 最短有效录音时长
AI_DAILY_CALL_BUDGET=20000     # AI调用24h硬预算（被盗刷时封顶成本）
AI_RPM_LIMIT=90                # 上游RPM客户端节流（<官方100）

# ---- 安全与限流 ----
SESSION_MAX_PER_IP=30           # 共享出口IP并发会话上限（20人同时问诊场景）             # 单IP活跃问诊会话上限（防内存膨胀攻击，ADD-2）
SESSION_MAX_TOTAL=500            # 全局活跃会话上限
SECRET_KEY=change-me-32+random-chars-please-generate-your-own
DOCTOR_USERNAME=admin            # 首次启动自动创建的默认医生账号（首期由管理员线下开通与重置）
DOCTOR_PASSWORD=ChangeMe_2026!   # 仅首次建库时生效；生产部署后立即修改！
SESSION_TTL_MINUTES=30           # 医生会话30分钟无操作登出（PRD F6-R5）
LOGIN_MAX_FAILS=5                # 连续失败锁定阈值
LOCKOUT_SECONDS=600              # 锁定时长（秒）=10分钟
PATIENT_RATE_LIMIT=200/min           # 患者端限流/分钟/IP（20人同刷≈120-180/min，含余量）            # 患者端接口限流/分钟/IP（医院共享出口20人同刷场景，2026-08-24 调整）        # 患者端接口限流（每IP每分钟，创建/轮次/fixed-phrase共用池）
MAX_AUDIO_BYTES=4000000          # 单轮音频base64解码后上限字节（16k*16bit单声道≈32KB/s，≈2分钟）
